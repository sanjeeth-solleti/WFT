# WINDOWS FORENSIC TOOLKIT (WFT) - ENVIRONMENT CONFIGURATION
# Copy to .env in the project root to override default external tool directories

# Eric Zimmerman CLI Tools directory (contains PECmd.exe, EvtxECmd, MFTECmd.exe, etc.)
WFT_EZTOOLS_DIR=./EZTools

# Individual Eric Zimmerman Tool Executable Overrides (optional)
WFT_EZ_RLA_EXE=./EZTools/rla.exe
WFT_EZ_PECMD_EXE=./EZTools/PECmd.exe
WFT_EZ_MFTECMD_EXE=./EZTools/MFTECmd.exe
WFT_EZ_EVTXECMD_EXE=./EZTools/EvtxECmd.exe
WFT_EZ_RECMD_EXE=./EZTools/RECmd.exe
WFT_EZ_LECMD_EXE=./EZTools/LECmd.exe
WFT_EZ_JLECMD_EXE=./EZTools/JLECmd.exe
WFT_EZ_AMCACHE_EXE=./EZTools/AmcacheParser.exe
WFT_EZ_SHIMCACHE_EXE=./EZTools/AppCompatCacheParser.exe
WFT_EZ_SBECMD_EXE=./EZTools/SBECmd.exe
WFT_EZ_SRUMECMD_EXE=./EZTools/SrumECmd.exe
WFT_EZ_WXTCMD_EXE=./EZTools/WxTCmd.exe
WFT_EZ_SQLECMD_EXE=./EZTools/SQLECmd.exe
WFT_EZ_RBCMD_EXE=./EZTools/RBCmd.exe
WFT_EZ_RECENTFILECACHE_EXE=./EZTools/RecentFileCacheParser.exe
WFT_EZ_SUMECMD_EXE=./EZTools/SumECmd.exe

# RegRipper 4.0 directory and binary
WFT_REGRIPPER_DIR=./RegRipper4.0
WFT_REGRIPPER_EXE=./RegRipper4.0/rip.exe

# Trellix Stinger executable (stinger64.exe or stinger32.exe)
WFT_STINGER_EXE=./stinger32.exe

# Hindsight executable or python script (optional; pyhindsight library is used natively)
WFT_HINDSIGHT_EXE=./hindsight.exe

# Bulk Extractor executable
WFT_BULK_EXTRACTOR_EXE=./bulk_extractor64.exe

# YARA Rules Directory
WFT_RULES_DIR=./rules

# Cases Storage Directory
WFT_CASES_DIR=./cases

# FastAPI Server Port & Host
WFT_HOST=127.0.0.1
WFT_PORT=8765
