# WINDOWS FORENSIC TOOLKIT (WFT) - ENVIRONMENT CONFIGURATION
# Copy to .env in the project root to override default external tool directories

# Eric Zimmerman CLI Tools directory (contains PECmd.exe, EvtxECmd, MFTECmd.exe, etc.)
WFT_EZTOOLS_DIR=./EZTools

# RegRipper 4.0 directory (contains rip.exe and plugins/)
WFT_REGRIPPER_DIR=./RegRipper4.0

# Trellix Stinger executable (stinger64.exe or stinger32.exe)
WFT_STINGER_EXE=./stinger32.exe

# Hindsight executable or python script (optional; pyhindsight library is used natively)
WFT_HINDSIGHT_EXE=./hindsight-main/hindsight.py

# YARA Rules Directory
WFT_RULES_DIR=./rules

# Cases Storage Directory
WFT_CASES_DIR=./cases

# FastAPI Server Port & Host
WFT_HOST=127.0.0.1
WFT_PORT=8765
